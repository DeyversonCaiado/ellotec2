# Serviço do integrador com o sistema de origem (Oracle do GESTCOM).
#
# Roda em processo próprio, separado da API — é um cliente HTTP da própria
# API ELLOTEC, então depende dela estar no ar. Ver
# app/shared/sistema_origem/app.py.
#
# Instalação (uma vez, como root):
#   sudo cp deploy/ellotec2-sincronizacao.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ellotec2-sincronizacao

[Unit]
Description=ELLOTEC ERP - sincronizacao com o sistema de origem (GESTCOM)
After=network-online.target ellotec2-api.service
Wants=network-online.target ellotec2-api.service

[Service]
Type=exec
User=ello
Group=ello
WorkingDirectory=/opt/ellotec2/backend
ExecStart=/opt/ellotec2/backend/.venv/bin/python -m app.shared.sistema_origem.app

# O loop chama os.._exit(1) de propósito quando um registro de origem está
# inválido — o dado precisa ser corrigido no ERP. Reinicia mesmo assim, com
# espera maior, para não entrar em loop de falha rápida.
Restart=always
RestartSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
