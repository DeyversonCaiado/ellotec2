# Serviço da API (FastAPI/uvicorn) do ELLOTEC ERP em produção.
#
# Instalação (uma vez, como root):
#   sudo cp deploy/ellotec2-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ellotec2-api
#
# O deploy (.github/workflows/deploy.yml) só reinicia:
#   sudo systemctl restart ellotec2-api

[Unit]
Description=ELLOTEC ERP API (FastAPI/uvicorn)
# Só sobe depois que a rede e o MySQL estiverem prontos — sem isso o
# primeiro acesso ao banco falha no boot da máquina.
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=exec
User=ello
Group=ello
WorkingDirectory=/opt/ellotec2/backend

# --reload NUNCA em produção: recarrega a cada arquivo tocado e mantém um
# processo supervisor a mais no ar sem necessidade.
# --host 0.0.0.0 para a API responder no IP da máquina (192.168.20.12:8000),
# não só em localhost — é assim que o front e o coletor a alcançam.
ExecStart=/opt/ellotec2/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=5

# Log vai para o journal do systemd: journalctl -u ellotec2-api -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
