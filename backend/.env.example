APP_NAME=ELLOTEC ERP API
AMBIENTE=desenvolvimento
DEBUG=true

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=fuse_erp
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=fuse_erp

# --- sistema de origem (Oracle do ERP) --------------------------------
# Lido por app/shared/sistema_origem/config.py. Sem estes valores, a correção
# de código de barras na bipagem responde 503 e o resto do sistema segue normal.
ELLOTEC_ORACLE_USER=
ELLOTEC_ORACLE_PASSWORD=
ELLOTEC_ORACLE_DSN=servidor:1521/ORCL
ELLOTEC_ORACLE_SCHEMA=GESTCOM
ELLOTEC_ORACLE_FUNCAO_CONTEXTO=GESTCOM2009
# DEIXE VAZIO. O caminho do Instant Client é descoberto pelo sistema
# operacional onde o processo roda (ver `diretorio_padrao_do_client` em
# app/shared/sistema_origem/gestcom/config.py):
#   Linux   -> /opt/oracle/instantclient_12_2
#   Windows -> C:\oracle\instantclient_19_28
#
# Preencha SÓ se o Instant Client estiver fora do lugar de sempre — e aí o
# valor tem que ser do sistema onde o processo RODA, não do de quem editou o
# arquivo. Um caminho Windows num .env copiado para o servidor Linux derrubou a
# sincronização em produção com "DPI-1047: Cannot locate a 64-bit Oracle Client
# library", porque o driver foi procurar libclntsh.so dentro de C:/oracle/.
#
# O modo thick não é opcional: o servidor do ERP é antigo e o modo thin recusa
# a conexão (DPY-3010). No Windows, use barra normal (C:/oracle/...) — barra
# invertida em arquivo .env vira escape.
ELLOTEC_ORACLE_CLIENT_DIR=
# Código gravado em fat_produtos.USUARIO_ALTERACAO — é código do cadastro do
# ERP, não o id do usuário daqui.
ELLOTEC_ORACLE_USUARIO_ALTERACAO=00200

JWT_SEGREDO=troque-este-segredo-por-uma-chave-aleatoria-forte-em-producao
JWT_ALGORITMO=HS256
JWT_ACCESS_TOKEN_MINUTOS=30
JWT_REFRESH_TOKEN_DIAS=30

# Origens do front autorizadas a chamar a API. O navegador bloqueia a resposta
# se a URL de onde a pagina foi aberta nao estiver aqui.
# Em producao (192.168.20.12) o front roda na 8504 e a API na 8000 — portas
# diferentes sao origens diferentes, entao a 8504 precisa estar listada:
#   CORS_ORIGENS=["http://192.168.20.12:8504"]
CORS_ORIGENS=["http://localhost:4200"]

# --- sistema de origem OUROWEB (SQL Server) ---------------------------
# Lido por app/shared/sistema_origem/ouroweb/config.py. Teste a conexão com:
#   python -m app.shared.sistema_origem.ouroweb.testar_conexao
OUROWEB_SQLSERVER_HOST=192.168.20.14
OUROWEB_SQLSERVER_PORTA=1433
OUROWEB_SQLSERVER_USER=
OUROWEB_SQLSERVER_PASSWORD=
# Vazio conecta no banco default do login.
OUROWEB_SQLSERVER_DATABASE=
